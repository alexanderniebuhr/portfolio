---
export const prerender = true;

import ExperienceList from "../components/ExperienceList.astro";
import ExportActions from "../components/ExportActions.astro";
import Box from "../components/layout/Box.astro";
import Center from "../components/layout/Center.astro";
import Cluster from "../components/layout/Cluster.astro";
import Grid from "../components/layout/Grid.astro";
import Icon from "../components/layout/Icon.astro";
import Sidebar from "../components/layout/Sidebar.astro";
import Stack from "../components/layout/Stack.astro";
import Switcher from "../components/layout/Switcher.astro";
import {
	CAPABILITIES,
	EXPERIENCE,
	PROJECTS,
	SITE,
	SOCIAL_LINKS,
} from "../data/profile.ts";
import BaseLayout from "../layouts/BaseLayout.astro";

const workSocialLinks = SOCIAL_LINKS.slice(0, 2);
---

<BaseLayout
	title={`Work & CV | ${SITE.name}`}
	description={`Curriculum vitae, engineering experience, and open-source work of ${SITE.name} — ${SITE.role}.`}
>
	<Center max="var(--measure-wide)">
		<Stack space="var(--space-2xl)">
			<section class="hero-container">
				<Stack space="var(--space-m)">
					<h1 id="main-content" tabindex="-1" class="hero-title">
						Work &amp; CV
					</h1>
					<p class="eyebrow"> {SITE.name} · {SITE.location} </p>
					<p class="lead">
						Over a decade of shipping backend infrastructure, cloud-native web
						platforms, open-source tooling, and accessible user interfaces —
						alongside engineers from Google, Meta, Cloudflare, and Vercel.
					</p>
					<p class="print-only meta-mono measure-none">
						{SITE.url} · {SITE.email} · github.com/alexanderniebuhr ·
						linkedin.com/in/alexanderniebuhr · x.com/realalexniebuhr
					</p>
					<Cluster space="var(--space-s)" class="no-print">
						<a href={`mailto:${SITE.email}`} class="action-primary">
							Get in touch
						</a>
						<ExportActions idPrefix="work" showPrint triggerLabel="Copy CV" />
						{workSocialLinks.map((link) => (
							<a href={link.href} class="action-link with-icon">
								{link.label}
								<Icon name="arrow-up-right" />
							</a>
						))}
					</Cluster>
				</Stack>
			</section>

			<section class="section-block">
				<Stack space="var(--space-l)">
					<Stack space="var(--space-xs)">
						<p class="eyebrow">Curriculum Vitae</p>
						<h2>Experience</h2>
					</Stack>

					<ExperienceList entries={EXPERIENCE} as="ol" />
				</Stack>
			</section>

			<section class="section-block">
				<Stack space="var(--space-l)">
					<Sidebar sideWidth="16rem" contentMin="60%" space="var(--space-m)">
						<Stack space="var(--space-xs)">
							<p class="eyebrow">Selected Work</p>
							<h2>Open source &amp; projects</h2>
						</Stack>
						<p class="muted">
							Active maintenance across the Astro ecosystem, Cloudflare Workers
							tooling, CSS utilities, and hardware integrations.
						</p>
					</Sidebar>

					<Grid
						as="ul"
						listSemantics
						min="19rem"
						space="var(--space-m)"
						class="card-grid"
					>
						{PROJECTS.map((project) => (
							<Box as="li" class="editorial-card">
								<Stack space="var(--space-2xs)">
									<p class="meta-mono measure-none">{project.role}</p>
									<h3>
										<a href={project.href} class="action-link with-icon">
											{project.name}
											<Icon name="arrow-up-right" />
										</a>
									</h3>
								</Stack>
								<p class="muted">{project.summary}</p>
								<Cluster as="ul" listSemantics space="var(--space-2xs)">
									{project.tags.map((tag) => (
										<li class="tag">{tag}</li>
									))}
								</Cluster>
							</Box>
						))}
					</Grid>
				</Stack>
			</section>

			<section class="section-block">
				<Stack space="var(--space-l)">
					<Stack space="var(--space-xs)">
						<p class="eyebrow">Technical Profile</p>
						<h2>Capabilities &amp; languages</h2>
					</Stack>

					<Switcher
						as="dl"
						threshold="44rem"
						space="var(--space-l)"
						class="capability-list"
					>
						{CAPABILITIES.map((group) => (
							<div class="capability-item">
								<dt>{group.title}</dt>
								<dd>{group.items}</dd>
							</div>
						))}
					</Switcher>
				</Stack>
			</section>
		</Stack>
	</Center>
</BaseLayout>
