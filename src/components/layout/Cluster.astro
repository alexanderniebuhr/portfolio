---
import type { HTMLAttributes, HTMLTag } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
	as?: HTMLTag;
	space?: string;
	justify?: string;
	align?: string;
	listSemantics?: boolean;
}

const {
	as = "div",
	space,
	justify,
	align,
	listSemantics = false,
	class: className,
	style,
	role,
	...attrs
} = Astro.props;

const Tag = as;
const resolvedRole = role ?? (listSemantics ? "list" : undefined);
const inlineStyle = [
	space ? `--space: ${space}` : null,
	justify ? `--justify: ${justify}` : null,
	align ? `--align: ${align}` : null,
	style,
]
	.filter(Boolean)
	.join("; ");
---

<Tag
	class:list={["cluster", className]}
	role={resolvedRole}
	style={inlineStyle || undefined}
	{...attrs}
>
	<slot />
</Tag>
