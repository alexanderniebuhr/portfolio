---
import type { HTMLAttributes, HTMLTag } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
	as?: HTMLTag;
	padding?: string;
	borderWidth?: string;
	invert?: boolean;
}

const {
	as = "div",
	padding,
	borderWidth,
	invert = false,
	class: className,
	style,
	...attrs
} = Astro.props;

const Tag = as;
const inlineStyle = [
	padding ? `--padding: ${padding}` : null,
	borderWidth ? `--border-width: ${borderWidth}` : null,
	style,
]
	.filter(Boolean)
	.join("; ");
---

<Tag
	class:list={["box", { invert }, className]}
	style={inlineStyle || undefined}
	{...attrs}
>
	<slot />
</Tag>
