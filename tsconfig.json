{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"types": ["./.cloudflare/types/index.d.ts", "node"]
	},
	"contentMappers": [
		{
			"package": "@astrojs/ts-content-mapper",
			"extensions": [".astro"]
		}
	],
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": [".cloudflare"]
}
