amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"

steps {
  ["biome"] = (Builtins.biome) {
    glob = List(
      "**/*.ts",
      "**/*.mts",
      "**/*.js",
      "**/*.mjs",
      "**/*.json",
      "**/*.jsonc",
      "**/*.css",
      "**/*.astro",
      "**/*.md",
      "**/*.yaml",
      "**/*.yml",
    )
    exclude = List("aube-lock.yaml", ".agents/**", ".claude/**")
    cache = true
    cache_inputs = List(
      "**/*.ts",
      "**/*.mts",
      "**/*.js",
      "**/*.mjs",
      "**/*.json",
      "**/*.jsonc",
      "**/*.css",
      "**/*.astro",
      "**/*.md",
      "**/*.yaml",
      "**/*.yml",
      "mise.toml",
    )
  }
}

hooks {
  ["pre-commit"] {
    steps {
      ["gitleaks"] = (Builtins.gitleaks) {
        scan = "staged"
      }
      ["typecheck"] {
        check = "aubr check"
        cache = true
        cache_inputs = List(
          "**/*.ts",
          "**/*.mts",
          "**/*.astro",
          "tsconfig.json",
          "package.json",
          "aube-lock.yaml",
          "mise.toml",
        )
      }
    }
  }
}
