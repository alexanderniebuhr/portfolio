{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"includes": ["**", "!**/aube-lock.yaml", "!**/.agents", "!**/.claude"]
	},
	"formatter": {
		"enabled": true
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"linter": {
			"enabled": true
		},
		"formatter": {
			"enabled": true,
			"indentScriptAndStyle": true,
			"whitespaceSensitivity": "strict"
		}
	},
	"markdown": {
		"formatter": {
			"enabled": true
		}
	},
	"yaml": {
		"formatter": {
			"enabled": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"preset": "recommended",
			"source": {
				"preset": "recommended",
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [{ "type": true }]
					}
				}
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"preset": "all"
			},
			"nursery": {
				"noLateCurrentTargetAccess": "error",
				"noMisusedSpread": "error",
				"noTripleSlashReference": "error",
				"noYamlEmptyMapValues": "error",
				"noYamlEmptySequenceEntries": "error",
				"usePackageJsonValidLicense": "error",
				"useValidNamespaceImports": "error"
			}
		},
		"domains": {
			"project": "recommended",
			"types": "recommended"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"suspicious": {
						"noReactSpecificProps": "error"
					}
				}
			}
		}
	]
}
